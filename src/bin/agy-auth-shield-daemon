#!/usr/bin/env bash
# Launcher for agy-auth-shield daemon (invoked by launchd, systemd, or wrapper autostart).
set -euo pipefail

SHIELD_HOME="${AGY_AUTH_SHIELD_HOME:-$HOME/.local/share/agy-auth-shield}"
if [[ -r "${SHIELD_HOME}/config.env" ]]; then
  _caller_port="${AGY_AUTH_SHIELD_PORT:-}"
  _caller_upstream="${AGY_AUTH_SHIELD_UPSTREAM:-}"
  # shellcheck disable=SC1091
  source "${SHIELD_HOME}/config.env" 2>/dev/null || true
  [[ -n "$_caller_port" ]] && export AGY_AUTH_SHIELD_PORT="$_caller_port"
  [[ -n "$_caller_upstream" ]] && export AGY_AUTH_SHIELD_UPSTREAM="$_caller_upstream"
fi
export AGY_AUTH_SHIELD_HOME="$SHIELD_HOME"

SCRIPT="${SHIELD_HOME}/agy_auth_shield.py"

python_ok() {
  local py="$1"
  [[ -x "$py" ]] || return 1
  "$py" -c 'import ssl, sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1
}

pick_python() {
  local cand
  if [[ -n "${AGY_AUTH_SHIELD_PYTHON:-}" ]] && python_ok "${AGY_AUTH_SHIELD_PYTHON}"; then
    printf '%s\n' "${AGY_AUTH_SHIELD_PYTHON}"
    return 0
  fi

  for cand in \
    "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3" \
    "/Library/Frameworks/Python.framework/Versions/3.13/bin/python3" \
    "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3" \
    "/Library/Frameworks/Python.framework/Versions/3.11/bin/python3" \
    "/Library/Frameworks/Python.framework/Versions/3.10/bin/python3" \
    "/opt/homebrew/bin/python3" \
    "/usr/local/bin/python3" \
    "$(command -v python3 2>/dev/null || true)" \
    "/usr/bin/python3"; do
    if [[ -n "$cand" ]] && python_ok "$cand"; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

PYTHON_BIN="$(pick_python || true)"
if [[ -z "$PYTHON_BIN" ]]; then
  echo "agy-auth-shield: Python 3.9+ with ssl support is required" >&2
  exit 1
fi

exec "$PYTHON_BIN" "$SCRIPT" "$@"
